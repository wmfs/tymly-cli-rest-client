{
  "name": "@wmfs/tymly-cli-rest-client",
  "version": "0.0.0-semantically-released",
  "description": "CLI tool to launch Tymly State Machines over REST",
  "main": "./lib/index.js",
  "keywords": [
    "cli",
    "tymly",
    "executions",
    "REST",
    "API",
    "state machines",
    "package"
  ],
  "scripts": {
    "cli": "node lib/cli",
    "test": "nyc mocha",
    "lint": "standard",
    "semantic-release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wmfs/tymly-cli-rest-client.git"
  },
  "author": "West Midlands Fire Service",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wmfs/tymly-cli-rest-client/issues"
  },
  "homepage": "https://github.com/wmfs/tymly-cli-rest-client#readme",
  "dependencies": {
    "axios": "1.20.0",
    "chalk": "4.1.2",
    "debug": "4.4.1"
  },
  "devDependencies": {
    "chai": "4.5.0",
    "conventional-changelog-metahub": "4.0.1",
    "cz-conventional-changelog": "3.3.0",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "semantic-release": "25.0.2",
    "standard": "17.1.2",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    },
    "tymly": {
      "sync": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "nyc": {
    "check-coverage": true,
    "lines": 95,
    "statements": 95,
    "functions": 95,
    "branches": 80
  }
}
